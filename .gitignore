# Scratch staging for files handed to the author mid-session.
# The app can only open files inside the working directory, so intermediates
# get copied here to be sent. They are working files, not deliverables —
# finished cuts live in reels/<date>-<slug>/ and are committed there.
.tmp-out/

# Her raw conference footage. The repo is public - raw.githubusercontent URLs
# are how Meta and Pinterest fetch from it - so source media with faces, a
# venue or third-party branding in it does not belong here. Finished cuts only.
reels/*/source/*.mov
reels/*/source/*.mp4
reels/*/source/*.jpg
reels/*/source/*.jpeg
reels/*/source/*.png
carousels/*/source/*.mov
carousels/*/source/*.mp4
carousels/*/source/*.jpg
carousels/*/source/*.jpeg
carousels/*/source/*.png
carousels/*/source/*.xlsx
carousels/*/source/*.pdf

# Freeze frames pulled from the source recording at build time. Regenerable,
# and they are raw source rather than finished output.
reels/*/build/frames/
carousels/*/build/frames/

# Overlay previews — they composite the raw freeze frames, so same rule.
reels/*/build/preview.png
carousels/*/build/preview.png

# Stills pulled from source for card placement. Same rule as frames/: they are
# raw source, and one of them is a frame of her desk. The repo is public.
reels/*/build/*-probe.png
carousels/*/build/*-probe.png

# Python bytecode.
__pycache__/
*.pyc

# The paid product itself. The repo is public, so nothing that IS the Vendor
# Payment System may be committed: not the built PDF and not guide_text.py,
# which holds all six prompts verbatim. The prompts are the product; shipping
# them here would publish a $24 download for nothing, and a first attempt at
# this commit was correctly blocked for exactly that. The text lives in the
# live Google Doc, which is its source of truth anyway, and the PDF reaches
# Gumroad through a Drive link that is locked again once Gumroad has copied it.
# The generator, the fonts, the README and the COVER are committed: the cover
# is an advertisement, and the generator carries no product text.
products/*/*.pdf
products/*/guide_text.py
products/*/build/pg-*.png
products/*/build/hi-*.png
products/*/build/sheet.png

# Freeze frames lifted from her screen recordings, and the preview/check
# contact sheets built from them. They are intermediates: the frames are her
# source media one step removed, and placement is already recorded in
# make_cards.py and the reel README. Finished cuts and the finished cards are
# committed; these are not.
reels/*/build/beats/*.png
reels/*/build/preview/
reels/*/build/check/
